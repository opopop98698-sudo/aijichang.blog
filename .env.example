# ==============================================================================
# aijichang.blog - 搜索引擎站长平台所有权验证 Meta 环境变量配置
# 在正式上线后，若选择 HTML 标签验证方式，填入对应平台的 content 代码并重新构建
# ==============================================================================

# 1. Google Search Console 验证代码 (填入 content 值)
GOOGLE_SITE_VERIFICATION=

# 2. Bing Webmaster Tools 验证代码 (填入 msvalidate.01 的 content 值)
BING_SITE_VERIFICATION=

# 3. 百度搜索资源平台验证代码 (填入 baidu-site-verification 的 content 值)
BAIDU_SITE_VERIFICATION=

# 4. 神马站长平台验证代码 (填入 shenma-site-verification 的 content 值)
SHENMA_SITE_VERIFICATION=

# 5. 360 搜索资源平台验证代码 (可选，填入 360-site-verification 的 content 值)
SO_SITE_VERIFICATION=
